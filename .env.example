
# =============================================================================
# Zeke AI — Configuration
# Copy this file to .env and update the values below.
# =============================================================================

# --- Authentication ---
# Generate a secure random secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ZEKE_JWT_SECRET=change-me-to-a-random-string
ZEKE_JWT_EXPIRY_HOURS=24

# Users as JSON: {"username": "bcrypt_hashed_password", ...}
# Generate a password hash:
#   python3 -c "from passlib.hash import bcrypt; print(bcrypt.hash('your_password'))"
# Example below uses password "zeke" — CHANGE THIS before deploying.
ZEKE_USERS_JSON='{"balasaravanank": "$2b$12$LJ3m4ys2Fa/UWGQlGOaOSuexdHNRN6C3tMiLtlFSH0q0MbxYwnZdC"}'

# --- Paths ---
ZEKE_BASE_DIR=~/zeke-ai
ZEKE_MODELS_DIR=~/zeke-ai/models
ZEKE_DATA_DIR=~/zeke-ai/data

# --- Model Configuration ---
ZEKE_WHISPER_MODEL=ggml-base.en.bin
ZEKE_LLM_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
ZEKE_PIPER_VOICE=en_US-lessac-medium

# --- LLM Settings ---
ZEKE_LLM_CONTEXT_SIZE=2048
ZEKE_LLM_MAX_TOKENS=256
ZEKE_LLM_PARALLEL_SLOTS=2
ZEKE_LLM_THREADS=3
ZEKE_LLM_HOST=127.0.0.1
ZEKE_LLM_PORT=8081
ZEKE_LLM_TEMPERATURE=0.7

# --- Audio ---
ZEKE_STT_SAMPLE_RATE=16000
ZEKE_TTS_SAMPLE_RATE=22050
ZEKE_VAD_AGGRESSIVENESS=2
ZEKE_VAD_SILENCE_MS=300

# --- Backup (optional — enables automatic database backup to GitHub) ---
# ZEKE_GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# ZEKE_BACKUP_REPO=balasaravanank/zeke-ai-data
# ZEKE_BACKUP_INTERVAL_MINUTES=15

# --- Server ---
ZEKE_HOST=0.0.0.0
ZEKE_PORT=8000
ZEKE_LOG_LEVEL=info
